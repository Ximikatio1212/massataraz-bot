// Prisma schema for Massa Taraz shop bot

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  pending_payment
  pending_verification
  paid
  processing
  shipped
  completed
  cancelled
}

enum PaymentStatus {
  pending
  pending_verification
  paid
  rejected
}

enum CartItemType {
  product
  course
}

enum ConversationState {
  // Product creation
  WAITING_PRODUCT_NAME
  WAITING_PRODUCT_PRICE
  WAITING_PRODUCT_DESCRIPTION
  WAITING_PRODUCT_CATEGORY
  WAITING_PRODUCT_STOCK
  WAITING_PRODUCT_IMAGE

  // Category creation
  WAITING_CATEGORY_NAME
  WAITING_CATEGORY_DESCRIPTION
  WAITING_CATEGORY_IMAGE

  // Course creation
  WAITING_COURSE_NAME
  WAITING_COURSE_DESCRIPTION
  WAITING_COURSE_PRICE
  WAITING_COURSE_ITEMS
  WAITING_COURSE_IMAGE

  // Order flow
  WAITING_ORDER_NAME
  WAITING_ORDER_REGION
  WAITING_ORDER_CITY
  WAITING_ORDER_ADDRESS
  WAITING_ORDER_PHONE
  WAITING_RECEIPT

  // Payment reject
  WAITING_REJECT_REASON

  // None
  NONE
}

model User {
  id           Int      @id @default(autoincrement())
  telegramId   BigInt   @unique
  username     String?
  firstName    String?
  lastName     String?
  role         String   @default("user")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cartItems    CartItem[]
  orders       Order[]
  state        UserState?
  payments     Payment[]

  @@index([telegramId])
  @@index([role])
}

model UserState {
  id             Int               @id @default(autoincrement())
  userId         Int               @unique
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  state          ConversationState @default(NONE)
  payload        Json?
  canvasChatId   BigInt?
  canvasMessageId Int?
  updatedAt      DateTime          @updatedAt

  @@index([state])
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@index([isActive])
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  price       Decimal   @db.Decimal(12, 2)
  imageUrl    String?
  categoryId  Int
  category    Category  @relation(fields: [categoryId], references: [id])
  stock       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  cartItems   CartItem[]
  courseItems CourseItem[]
  orderItems  OrderItem[]

  @@index([categoryId])
  @@index([isActive])
  @@index([stock])
}

model Course {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  price       Decimal   @db.Decimal(12, 2)
  imageUrl    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items       CourseItem[]
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([isActive])
}

model CourseItem {
  id         Int     @id @default(autoincrement())
  courseId   Int
  course     Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product @relation(fields: [productId], references: [id])
  quantity   Int     @default(1)

  @@unique([courseId, productId])
  @@index([productId])
}

model CartItem {
  id        Int          @id @default(autoincrement())
  userId    Int
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int?
  product   Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  courseId  Int?
  course    Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  type      CartItemType
  quantity  Int          @default(1)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId])
  @@index([productId])
  @@index([courseId])
  @@unique([userId, productId])
  @@unique([userId, courseId])
}

model Order {
  id                Int           @id @default(autoincrement())
  userId            Int
  user              User          @relation(fields: [userId], references: [id])
  total             Decimal       @db.Decimal(12, 2)
  status            OrderStatus   @default(pending_payment)
  paymentStatus     PaymentStatus @default(pending)
  fullName          String?
  region            String?
  city              String?
  address           String?
  phone             String?
  receiptUrl        String?
  receiptFileName   String?
  receiptFileId     String?
  receiptMimeType   String?
  receiptSubmittedAt DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  paidAt            DateTime?

  items             OrderItem[]
  payments          Payment[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int?
  product     Product? @relation(fields: [productId], references: [id])
  courseId    Int?
  course      Course?  @relation(fields: [courseId], references: [id])
  productName String
  price       Decimal @db.Decimal(12, 2)
  quantity    Int
  subtotal    Decimal @db.Decimal(12, 2)

  @@index([orderId])
  @@index([productId])
  @@index([courseId])
}

model Payment {
  id            Int           @id @default(autoincrement())
  orderId       Int
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId        Int
  user          User          @relation(fields: [userId], references: [id])
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(pending)
  receiptUrl    String?
  receiptFileName String?
  receiptFileId String?
  receiptMimeType String?
  reason        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([status])
}

// Трекер обработанных Telegram-апдейтов (защита от двойной обработки)
model WebhookUpdate {
  id          Int      @id @default(autoincrement())
  updateId    BigInt   @unique
  processedAt DateTime @default(now())

  @@index([processedAt])
}