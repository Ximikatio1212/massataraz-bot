BOT_TOKEN=
# Секрет для webhook Telegram (генерируется на сайте BotFather-гайда; любой длинный токен из 32+ символов)
WEBHOOK_SECRET=
DATABASE_URL=

ADMIN_IDS=

PAYMENT_PHONE=
PAYMENT_DETAILS=

STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Публичный endpoint S3 (R2 public bucket) — если используется
STORAGE_PUBLIC_ENDPOINT=

# ── ИИ-консультант (опционально) ──
# Провайдер: gemini (лучшее бесплатное качество, дефолт) | mistral | groq | openrouter
AI_PROVIDER=gemini
# API-ключ провайдера (Gemini: из Google AI Studio; Mistral: api.mistral.ai; Groq; OpenRouter)
AI_API_KEY=
# Модель (необязательно; по умолчанию поставляется для каждого провайдера)
AI_MODEL=